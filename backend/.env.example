NODE_ENV=development
PORT=3000

# Use DATABASE_URL if you want a single connection string.
# For local backend -> Render PostgreSQL, use the Render EXTERNAL DATABASE URL.
DATABASE_URL=

# Alternative to DATABASE_URL:
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Comma-separated list of allowed frontend origins.
FRONTEND_URL=http://localhost:5174,http://localhost:4173
CORS_ORIGINS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
